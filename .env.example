# ==============================================================================
# PLANTILLA DE EJEMPLO DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como ".env" para configurar tu entorno local:
#   cp .env.example .env
#
# Este archivo SÍ se sube a GitHub porque NO contiene secretos reales.

# Base de Datos PostgreSQL
DB_USERNAME=tu_usuario_postgres
DB_PASSWORD=tu_password_seguro

# Clave secreta para firma de JWT (mínimo 256 bits en hexadecimal)
JWT_SECRET_KEY=tu_clave_secreta_jwt_de_al_menos_256_bits_aqui
